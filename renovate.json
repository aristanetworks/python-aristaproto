{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "UTC",
  "minimumReleaseAge": "7 days",
  "enabledManagers": [
    "github-actions",
    "pep621",
    "pre-commit"
  ],
  "pre-commit": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "commitMessagePrefix": "CI: "
  },
  "packageRules": [
    {
      "description": "Maintain production and build dependencies for Python",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "build-system.requires",
        "project.dependencies",
        "project.optional-dependencies"
      ],
      "semanticCommitType": "chore",
      "commitMessagePrefix": "Bump(requirements): "
    },
    {
      "description": "Maintain development dependencies for Python",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "dependency-groups"
      ],
      "semanticCommitType": "ci",
      "commitMessagePrefix": "CI(requirements): "
    },
    {
      "description": "Maintain dependencies for GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "commitMessagePrefix": "CI: ",
      "pinDigests": true
    },
    {
      "description": "Preserve the supported Python version matrix",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "Handling hook rev autoupdates.",
      "matchManagers": [
        "pre-commit"
      ],
      "matchDepTypes": [
        "repository"
      ],
      "enabled": true,
      "semanticCommitType": "ci",
      "commitMessagePrefix": "CI: "
    },
    {
      "description": "pre-commit Python additional_dependencies.",
      "matchManagers": [
        "pre-commit"
      ],
      "matchDepTypes": [
        "pre-commit-python"
      ],
      "semanticCommitType": "ci",
      "commitMessagePrefix": "CI: ",
      "rangeStrategy": "bump"
    }
  ]
}
